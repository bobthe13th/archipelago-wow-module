# azerothcore-wotlk/modules/archipelago_wow/conf/archipelago_wow.conf.dist

[worldserver]

###################################################################################################
# ARCHIPELAGO WOW MODULE
#
#    Archipelago.Enabled
#        Description: Enable the Archipelago multiworld client.
#        Default:     0 (disabled)

Archipelago.Enabled = 0

#    Archipelago.ServerAddress
#        Description: Hostname or IP of the Archipelago server to connect to.
#        Default:     "localhost"

Archipelago.ServerAddress = "localhost"

#    Archipelago.ServerPort
#        Description: Port of the Archipelago server.
#        Default:     38281

Archipelago.ServerPort = 38281

#    Archipelago.SlotName
#        Description: The player slot name for this realm in the multiworld.
#        Default:     ""

Archipelago.SlotName = ""

#    Archipelago.Password
#        Description: Room password, if the Archipelago server requires one.
#        Default:     ""

Archipelago.Password = ""

#    Archipelago.DeliveryCharacter
#        Description: Character name that receives AP-granted items via mail.
#        Default:     ""

Archipelago.DeliveryCharacter = ""

#    Archipelago.UseTLS
#        Description: Connect over wss:// (TLS) instead of plain ws://.
#        Default:     0 (disabled)

Archipelago.UseTLS = 0

#    Archipelago.ReconnectMinSeconds
#        Description: Initial delay before retrying a dropped connection.
#        Default:     2

Archipelago.ReconnectMinSeconds = 2

#    Archipelago.ReconnectMaxSeconds
#        Description: Maximum backoff delay between reconnect attempts.
#        Default:     60

Archipelago.ReconnectMaxSeconds = 60
###################################################################################################
