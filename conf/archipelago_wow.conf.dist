# azerothcore-wotlk/modules/archipelago_wow/conf/archipelago_wow.conf.dist

[worldserver]

###################################################################################################
# ARCHIPELAGO WOW MODULE
#
#    Archipelago.Enabled
#        Description: Enable the Archipelago multiworld client.
#        Default:     0 (disabled)

Archipelago.Enabled = 0

#    Archipelago.ServerAddress
#        Description: Hostname or IP of the Archipelago server to connect to.
#        Default:     "localhost"

Archipelago.ServerAddress = "localhost"

#    Archipelago.ServerPort
#        Description: Port of the Archipelago server.
#        Default:     38281

Archipelago.ServerPort = 38281

#    Archipelago.SlotName
#        Description: The player slot name for this realm in the multiworld.
#        Default:     ""

Archipelago.SlotName = ""

#    Archipelago.Password
#        Description: Room password, if the Archipelago server requires one.
#        Default:     ""

Archipelago.Password = ""

#    Archipelago.DeliveryCharacter
#        Description: Character name that receives AP-granted items via mail.
#        Default:     ""

Archipelago.DeliveryCharacter = ""

#    Archipelago.UseTLS
#        Description: Connect over wss:// (TLS) instead of plain ws://.
#        Default:     0 (disabled)

Archipelago.UseTLS = 0

#    Archipelago.ReconnectMinSeconds
#        Description: Initial delay before retrying a dropped connection.
#        Default:     2

Archipelago.ReconnectMinSeconds = 2

#    Archipelago.ReconnectMaxSeconds
#        Description: Maximum backoff delay between reconnect attempts.
#        Default:     60

Archipelago.ReconnectMaxSeconds = 60

#    Archipelago.ProficiencyGating
#        Description: Enable armor/weapon proficiency suppression (M4 gate
#                      family). Only turn this on when the connected seed's
#                      player YAML also has proficiency_gating enabled --
#                      this module has no way to read that option from the
#                      AP server itself, so the two must be set to match by
#                      hand. Leaving this off while the seed has the option
#                      on just means those items behave as filler; turning
#                      this on for a seed that does NOT have the option is
#                      the dangerous direction, since it will permanently
#                      block equipping Plate/Mail/Leather/etc for every
#                      character on the realm (the flag can never reach
#                      tier 1 -- the item was never placed in that seed).
#        Default:     0 (disabled)

Archipelago.ProficiencyGating = 0

#    Archipelago.AccessGating
#        Description: Enable Auction House / Hearthstone / mailbox-send
#                      access suppression (M4 gate family). Only turn this
#                      on when the connected seed's player YAML also has
#                      access_gating enabled -- same manual-sync
#                      requirement and same "off is the safe direction" as
#                      Archipelago.ProficiencyGating above. Note this only
#                      covers 3 of the design's 5 access types: bank access
#                      and gathering (mining/herbalism/skinning) have no
#                      suppression hook in this AzerothCore checkout and are
#                      not gated by this module (see content/gates.yaml's
#                      comment for the research behind that).
#        Default:     0 (disabled)

Archipelago.AccessGating = 0

#    Archipelago.CharacterUnlockGating
#        Description: Enable bank bag slot / dual spec / talent point
#                      suppression (M4 gate family). Only turn this on when
#                      the connected seed's player YAML also has
#                      character_unlock_gating enabled -- same manual-sync
#                      requirement and same "off is the safe direction" as
#                      the other gate toggles above. Glyph Slot gating
#                      (named in the design spec) is not implemented by
#                      this module -- see content/gates.yaml's comment.
#        Default:     0 (disabled)

Archipelago.CharacterUnlockGating = 0

#    Archipelago.DeliveryPolicy
#        Description: How Archipelago-granted items reach players (M4 Sec7).
#                      Only turn this away from the default when the
#                      connected seed's player YAML also has a matching
#                      DeliveryPolicy option -- this module has no way to
#                      read that option from the AP server itself, same
#                      manual-sync requirement as the gate-family toggles
#                      above. Unlike those toggles, there is no "safe
#                      direction" here (delivery policy never blocks
#                      progression), so a mismatch just means items don't
#                      arrive the way the seed's players expect, not a
#                      softlock. AuctionHouse is refused (falls back to
#                      EveryoneReceives, logged as an error) whenever
#                      Archipelago.AccessGating is also on, since it can
#                      list a player's own AP-earned item on the Auction
#                      House before Auction House Access is granted -- a
#                      real softlock, not just a mismatch.
#        Values:      "EveryoneReceives" (default) | "SharedCacheNpc" |
#                      "AuctionHouse" | "FirstToClaim"
#        Default:     "EveryoneReceives"

Archipelago.DeliveryPolicy = "EveryoneReceives"

#    Archipelago.AuctionHouseCostTier
#        Description: Only used when Archipelago.DeliveryPolicy is
#                      "AuctionHouse" -- the buyout price band for listed
#                      items (M4 Sec7.1). Base price is the item's vendor
#                      BuyPrice if set, else 4x its SellPrice, else a 1
#                      silver floor for zero-priced custom items. Cheap is
#                      1/4 of base, Expensive is 4x base, Random picks
#                      uniformly among Free/Cheap/Market/Expensive per
#                      listing. Listings are system auctions (no real
#                      seller) -- no deposit is charged and no gold payout
#                      is owed to anyone on sale.
#        Values:      "Free" | "Cheap" | "Market" (default) | "Expensive" |
#                      "Random"
#        Default:     "Market"

Archipelago.AuctionHouseCostTier = "Market"

#    Archipelago.CatchUpPolicy
#        Description: How a brand-new character catches up on WoW items the
#                      realm has already received (M4 Sec7.2) -- every
#                      delivered item is logged once, regardless of
#                      DeliveryPolicy, but historically only reached one
#                      designated character (EveryoneReceives'
#                      DeliveryCharacter); every other character starts with
#                      none of it. Only turn this away from the default when
#                      the connected seed's player YAML also has a matching
#                      CatchUpPolicy option -- same manual-sync requirement
#                      as every other option above. "Nothing" is the safe
#                      default (no behavior change from pre-Task-16).
#        Values:      "AllMailedOnLogin" | "Nothing" (default) |
#                      "PercentPerLevel" | "LevelScaledBundle"
#        Default:     "Nothing"

Archipelago.CatchUpPolicy = "Nothing"

#    Archipelago.CatchUpPercentPerLevel
#        Description: Only used when Archipelago.CatchUpPolicy is
#                      "PercentPerLevel" -- what percentage of the realm's
#                      total delivery history is granted to a character on
#                      each level-up, until they're fully caught up.
#        Default:     10

Archipelago.CatchUpPercentPerLevel = 10
###################################################################################################

#    Archipelago.DeathLinkSendEnabled
#        Description: When true, a genuinely player-caused death on this
#                      realm broadcasts a DeathLink Bounce to the connected
#                      multiworld (M4 Sec11). Independent of
#                      Archipelago.DeathLinkReceiveEnabled -- a realm can
#                      send without receiving, or vice versa. Only turn this
#                      on when the connected seed's player YAML also has
#                      death_link_send enabled -- same manual-sync
#                      requirement as every other option above.
#        Default:     false

Archipelago.DeathLinkSendEnabled = 0

#    Archipelago.DeathLinkReceiveEnabled
#        Description: When true, an incoming DeathLink Bounce from the
#                      multiworld kills every online player on this realm
#                      (M4 Sec11). Same manual-sync requirement as
#                      DeathLinkSendEnabled above -- must match the
#                      connected seed's death_link_receive option.
#        Default:     false

Archipelago.DeathLinkReceiveEnabled = 0

#    Archipelago.DeathLinkSendCooldownSeconds
#        Description: Minimum seconds between two outgoing DeathLink sends --
#                      prevents a raid wipe (many players dying within the
#                      same few seconds) from spamming the multiworld with
#                      one Bounce per player. Deaths suppressed by this
#                      cooldown are logged, not silently dropped.
#        Default:     15

Archipelago.DeathLinkSendCooldownSeconds = 15

#    Archipelago.DeathLinkReceiveCooldownSeconds
#        Description: Minimum seconds between two incoming DeathLink kills
#                      being applied -- prevents a cascade where several
#                      other slots' deaths arrive in a burst and repeatedly
#                      re-kill this realm's players. Bounces suppressed by
#                      this cooldown are logged, not silently dropped.
#        Default:     15

Archipelago.DeathLinkReceiveCooldownSeconds = 15
###################################################################################################

#    Archipelago.SpiritHealerVariant
#        Description: Which of resurrection sickness and spirit-healer
#                      durability loss are suppressed on resurrection (M4
#                      Sec11). "NoResSickness"/"NoDurabilityLoss" each
#                      suppress exactly one; "Neither" suppresses both
#                      (read as "neither penalty applies"). Sickness
#                      suppression applies to every resurrection source,
#                      not just the spirit healer -- see the module's
#                      ArchipelagoDeathLinkScript.cpp for why. Durability
#                      suppression is a realm-wide rate override, re-applied
#                      on both startup and `.reload config`. Only turn
#                      this away from the default when the connected seed's
#                      player YAML also has a matching SpiritHealerVariant
#                      option -- same manual-sync requirement as every
#                      other option above.
#        Values:      "Vanilla" (default) | "NoResSickness" |
#                      "NoDurabilityLoss" | "Neither"
#        Default:     "Vanilla"

Archipelago.SpiritHealerVariant = "Vanilla"
###################################################################################################

#    Archipelago.ComboUnlocksScope
#        Description: Which expansion-tier race/class combo unlocks (M4
#                      Sec5.5) are gated behind their own AP item, instead of
#                      being creatable from a fresh realm. "Tbc" gates Blood
#                      Elf and Draenei (the two TBC-added races, playable as
#                      any pre-existing class); "Wotlk" gates the Death
#                      Knight class (WotLK's one new class, playable as any
#                      pre-existing race); "Both" gates both independently.
#                      This is expansion-tier gating only, not full
#                      per-race+class combo granularity -- see the apworld's
#                      ComboUnlocksScope option docstring for why finer
#                      granularity is out of scope for a module-only
#                      (non-MPQ-patching) implementation. Realm-wide
#                      character-creation config, re-applied on both startup
#                      and `.reload config`. Only turn this away from the
#                      default when the connected seed's player YAML also
#                      has a matching combo_unlocks_scope option -- same
#                      manual-sync requirement as every other option above.
#        Values:      "Off" (default) | "Tbc" | "Wotlk" | "Both"
#        Default:     "Off"

Archipelago.ComboUnlocksScope = "Off"
###################################################################################################

#    Archipelago.InstanceClearMode
#        Description: How much of Molten Core/Sunwell Plateau/Icecrown
#                      Citadel (Task 23, M4 Sec5.4) must die before that
#                      raid's instance-clear location check fires.
#                      "AllBosses" (default) requires every boss configured
#                      for that raid to have died at least once, across
#                      however many attempts/raid nights it takes --
#                      resurrection-prone or multi-phase fights (Sunwell's
#                      Eredar Twins, Kalecgos, M'uru) are handled correctly
#                      regardless of kill order. "FinalBossOnly" fires the
#                      instant the raid's own final boss dies, matching how
#                      the two M2 dungeons (Ragefire Chasm, Deadmines)
#                      already behave -- those two dungeons are NOT affected
#                      by this setting either way, since they have no
#                      configured boss roster to track. Realm-wide, not
#                      per-character; re-applied on both startup and
#                      `.reload config` has no effect here since this value
#                      is read live on every boss kill, not cached into a
#                      pushed sWorld config value like ComboUnlocksScope
#                      above. Only turn this away from the default when the
#                      connected seed's player YAML also has a matching
#                      instance_clear_mode option.
#        Values:      "AllBosses" (default) | "FinalBossOnly"
#        Default:     "AllBosses"

Archipelago.InstanceClearMode = "AllBosses"
###################################################################################################

#    Archipelago.GameMode
#        Description: Which goal-mode the connected AP seed is generated
#                      for. Found necessary during Task 23/24's own review,
#                      not originally planned for either task: this module's
#                      bespoke C++ AP client has no embedded rules-evaluation
#                      engine (unlike the reference Python client), so it
#                      cannot derive "is the goal met" from anything the AP
#                      server sends it -- it must independently know which
#                      mode is active to ever report completion at all. Without
#                      this set correctly, the worldserver will never send a
#                      goal-complete status update for anything but Sprint,
#                      even if the connected seed's own game_mode option (and
#                      its completion_condition) says otherwise. Modes with
#                      no real content yet (KeyHunt, Artisan, Collector,
#                      AchievementHunt, Gladiator, Explorer, FishingQuest) are
#                      accepted here without error but never report
#                      completion, matching the apworld's own
#                      goals.py deferral for those modes.
#        Values:      "Sprint" (default) | "KeyHunt" | "Classic" |
#                      "BurningCrusade" | "Wrath" | "Completionist" |
#                      "Artisan" | "Collector" | "AchievementHunt" |
#                      "Gladiator" | "Explorer" | "FishingQuest"
#        Default:     "Sprint"

Archipelago.GameMode = "Sprint"

#    Archipelago.CompletionistExpansion
#        Description: Only relevant when Archipelago.GameMode is
#                      "Completionist" (Task 24) -- which expansion's
#                      instance-clear locations must ALL be cleared to
#                      complete the goal. Must match the connected seed's
#                      own completionist_expansion option.
#        Values:      "Vanilla" (default) | "Tbc" | "Wotlk"
#        Default:     "Vanilla"

Archipelago.CompletionistExpansion = "Vanilla"
###################################################################################################

#    Archipelago.KeyHuntKeysRequired
#        Description: Only relevant when Archipelago.GameMode is "KeyHunt"
#                      (Task 25) -- how many "Key Hunt: Key" items must be
#                      received to complete the goal, alongside
#                      KeyHuntInstancesRequired raids/dungeons also being
#                      cleared. Must match the connected seed's own
#                      key_hunt_keys_required option.
#        Default:     10

Archipelago.KeyHuntKeysRequired = 10

#    Archipelago.KeyHuntInstancesRequired
#        Description: Only relevant when Archipelago.GameMode is "KeyHunt"
#                      (Task 25) -- how many of the 5 existing instance-clear
#                      raids/dungeons (Ragefire Chasm, Deadmines, Molten
#                      Core, Sunwell Plateau, Icecrown Citadel) must also be
#                      cleared, alongside KeyHuntKeysRequired keys. Must
#                      match the connected seed's own
#                      key_hunt_instances_required option.
#        Default:     1

Archipelago.KeyHuntInstancesRequired = 1
###################################################################################################
